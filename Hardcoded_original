            tds.append(f"<td style='{base_style}'>{sanitize_cell_value(val)}</td>")
        rows_html.append("<tr>" + "".join(tds) + "</tr>")

    # 최종 완성
    t2_final = (
        "<table style='border-collapse:collapse; table-layout:fixed; width:auto; font-family:\"Malgun Gothic\"; font-size:10pt;'>"
