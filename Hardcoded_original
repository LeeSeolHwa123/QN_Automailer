# 파일 파싱 & 신규/삭제 판별
# =========================
QN_RE = re.compile(r"\b(\d{8})\b")
DATE_RE = re.compile(r"\b(\d{2}/\d{2}/\d{2})\b")

def parse_export_txt(filepath, anchor_qn):
    """
    SAP Export 텍스트를 파싱해서
    - QN: 8자리
    - Created: 'YYYY.MM.DD' 형식으로 변환하여 반환
    """
    log(f"[PARSE] 파일 열기: {filepath}")
    if not os.path.isfile(filepath): raise RuntimeError(f"파일 없음: {filepath}")
    with open(filepath,"r",encoding="utf-8-sig",errors="ignore") as f:
        lines=[ln.rstrip("\r\n") for ln in f]
    log(f"[PARSE] 총 라인수: {len(lines)} / anchor_qn={anchor_qn}")

    header_idx=None
    header_text=""
    for i,ln in enumerate(lines):
        if "Notif" in ln and "Created" in ln:
            header_idx=i; header_text=ln; break
    if header_idx is None:
        log("[PARSE] 헤더(Notif/Created) 미발견 → 데이터 0")
        return []

    log(f"[PARSE] 헤더 인덱스={header_idx} / 헤더='{header_text}'")
    rows=[]
    for ln in lines[header_idx+1:]:
        s=ln.strip()
        if not s or "Outstanding notification" in s: continue
        m=QN_RE.search(s); 
        if not m: continue
        qn=m.group(1)
        ds=DATE_RE.findall(s)
        if not ds: continue

        # --- 날짜 변환: 'MM/DD/YY' -> 'YYYY.MM.DD'
        raw_date = ds[0]
        try:
            dt_obj = _dt.strptime(raw_date, "%y/%m/%d")
            created_fmt = dt_obj.strftime("%Y.%m.%d")
        except Exception as e:
            log(f"[PARSE] 날짜 변환 실패: {raw_date} ({e})")
            created_fmt = raw_date  # 실패시 원본 유지

        rows.append({"QN":qn,"Created":created_fmt})
    log(f"[PARSE] 데이터 행 파싱={len(rows)}건")

    if not rows:
        return []

    if not anchor_qn:
        log(f"[PARSE] anchor 없음 → 신규={len(rows)}건 (예: {rows[:3]})")
        return rows

    seq=[r["QN"] for r in rows]
    try:
        idx = seq.index(str(anchor_qn).strip())
        new_rows = rows[idx+1:]
        log(f"[PARSE] anchor 위치={idx} → 신규={len(new_rows)}건 (예: {new_rows[:3]})")
        return new_rows
    except ValueError:
        log("[PARSE] anchor 미일치 → 전체 신규 처리")
        log(f"[PARSE] 신규={len(rows)}건 (예: {rows[:3]})")
        return rows

def load_qn_list(filepath):
    if not os.path.isfile(filepath): return []
    with open(filepath,"r",encoding="utf-8-sig",errors="ignore") as f:
        lines=[ln.rstrip("\r\n") for ln in f]
    got=[]
    for ln in lines:
        m = QN_RE.search(ln)
        if m: got.append(m.group(1))
    return got

def detect_deleted(prev_file, today_file):
    prev_q = set(load_qn_list(prev_file))
    today_q= set(load_qn_list(today_file))
    deleted = sorted(list(prev_q - today_q))
    log(f"[DELCHK] prev={os.path.basename(prev_file)}({len(prev_q)}) → today={os.path.basename(today_file)}({len(today_q)}) / 삭제추정={deleted}")
    return deleted

