def safe_float(s):
    """문자열에서 숫자만 추출해 float으로 변환"""
    if not s:
        return None
    try:
        s = str(s).strip().replace(",", ".")
        return float(re.sub(r"[^0-9.]", "", s))
    except:
        return None


