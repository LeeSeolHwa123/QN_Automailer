def parse_first_table_C1Ck_2row_header():
    outlook = win32.Dispatch("Outlook.Application")
    insp = outlook.ActiveInspector()
    if insp is None:
        raise RuntimeError("현재 열려 있는 Outlook 메일이 없습니다.")
    mail = insp.CurrentItem
    doc = mail.GetInspector.WordEditor

    # ✅ 첫 번째 표 선택
    tbl = doc.Tables(1)
    rows = tbl.Rows.Count
    cols = tbl.Columns.Count
    print(f"[INFO] 첫 번째 표(C1~Ck): {rows}행 × {cols}열")

    # 상단 2행 헤더 → 실제 헤더 이름은 1행에서 가져오기
    headers = []
    for c in range(1, cols + 1):
        try:
            # 1행 텍스트 (No., 등록일, QN # 등)
            top_text = tbl.Cell(1, c).Range.Text.replace("\r", "").replace("\x07", "").strip()
            headers.append(top_text)
        except:
            headers.append("")
    print(f"[INFO] 1행 헤더 감지: {headers}")

    # 열 인덱스 찾기
    def find_col(keyword):
        for i, h in enumerate(headers):
            if keyword.lower() in h.lower():
                return i + 1
        return None

    idx_qn = find_col("qn") or find_col("QN #")
    idx_d3 = find_col("d-3c")
    idx_d5 = find_col("d-5c")
    idx_d8 = find_col("d-8")

    if not all([idx_qn, idx_d3, idx_d5, idx_d8]):
        raise RuntimeError("필수 열(QN, D-3C, D-5C, D-8)을 찾지 못했습니다.")

    total = 0
    sat_d3 = sat_d5 = sat_d8 = 0

    # 데이터 시작 행 자동 판별
    # 2행 전체 텍스트를 합쳐서 'elapsed time' 포함 여부 확인
    second_row_text = ""
    try:
        second_row_text = "".join(
            tbl.Cell(2, c).Range.Text.replace("\r", "").replace("\x07", "").lower()
            for c in range(1, tbl.Columns.Count + 1)
        )
    except:
        pass

    # Elapsed time 존재 여부에 따라 데이터 시작 행 결정
    data_start_row = 3 if "elapsed" in second_row_text else 2

    # 데이터 행 처리
    for r in range(data_start_row, rows + 1):
        try:
            qn = tbl.Cell(r, idx_qn).Range.Text.replace("\r", "").replace("\x07", "").strip()
            val_d3 = safe_float(tbl.Cell(r, idx_d3).Range.Text)
            val_d5 = safe_float(tbl.Cell(r, idx_d5).Range.Text)
            val_d8 = safe_float(tbl.Cell(r, idx_d8).Range.Text)

            if not qn or qn.lower() == "elapsed time":
                continue

            total += 1
            print(f"[ROW] QN={qn} | D-3C={val_d3} | D-5C={val_d5} | D-8={val_d8}")

            if val_d3 is not None and val_d3 < 1:
                sat_d3 += 1
            if val_d5 is not None and val_d5 < 5:
                sat_d5 += 1
            if val_d8 is not None and val_d8 < 20:
                sat_d8 += 1
        except Exception as e:
            print(f"[WARN] {r}행 처리 실패: {e}")
            continue


    print("\n=== 통계 요약 ===")
    print(f"총 건수: {total}")
